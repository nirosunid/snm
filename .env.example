# =============================================================================
# SMN — Social Media Manager SaaS Environment
# =============================================================================
# Copy this file to .env and fill in real values.
# Comments must live on their own line (docker-compose env_file does NOT support
# inline `# comments` after a value).
# Values are NEVER expanded inside env_file (no ${VAR} substitution); composed
# URLs (DATABASE_URL, RABBITMQ_URL) are assembled in docker-compose.yml from
# the atomics below.

# -----------------------------------------------------------------------------
# Postgres (self-hosted in Docker — no Supabase)
# -----------------------------------------------------------------------------
POSTGRES_USER=smn
POSTGRES_PASSWORD=changeme-dev-password
POSTGRES_DB=smn
# psql / pg_dump pick these up directly (literal copies of the atomics above
# because env_file does not expand variables):
PGPASSWORD=changeme-dev-password
PGDATABASE=smn

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=smn
RABBITMQ_DEFAULT_PASS=changeme-dev-password
# RABBITMQ_URL is constructed in docker-compose.yml — do not set it here.

# -----------------------------------------------------------------------------
# Celery Flower (task monitoring UI on port 5555)
# Format: user:password — change before exposing to any network
# -----------------------------------------------------------------------------
FLOWER_BASIC_AUTH=admin:changeme

# -----------------------------------------------------------------------------
# Payload CMS (apps/web)
# -----------------------------------------------------------------------------
# Min 32 chars. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=dev-payload-secret-key-change-in-production-at-least-32-chars
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Web ↔ Agents shared secret (min 32 chars)
# -----------------------------------------------------------------------------
AGENT_CMS_SECRET=changeme-agent-cms-secret-min-32-chars-please

# -----------------------------------------------------------------------------
# Agents service (apps/agents) — Python FastAPI + Celery
# -----------------------------------------------------------------------------
AGENT_SERVICE_URL=http://agents:8001
AGENT_SERVICE_PORT=8001

# Default LLM provider/model used when the per-stage envs below are unset.
# Set DEFAULT_LLM_PROVIDER to one of: ollama | google | openai | anthropic
#
# Default ships as Ollama for zero-key first-run boot. Requires:
#   brew install ollama
#   ollama pull llama3.2
# (Agents container reaches host via host.docker.internal:11434.)
#
# Upgrade paths once you have keys:
#   DEFAULT_LLM_PROVIDER=google     DEFAULT_LLM_MODEL=gemini-2.0-flash-lite
#   DEFAULT_LLM_PROVIDER=anthropic  DEFAULT_LLM_MODEL=claude-sonnet-4-6
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.2

# Per-stage overrides (optional). When set, take precedence over DEFAULT_*.
# Recommended for the founder's quality validation: keep the planner/reviewer on
# a cheap model (Gemini Flash or Haiku) and put the writer on Claude Sonnet.
# LLM_PLANNER_PROVIDER=google
# LLM_PLANNER_MODEL=gemini-2.0-flash-lite
# LLM_WRITER_PROVIDER=anthropic
# LLM_WRITER_MODEL=claude-sonnet-4-6
# LLM_REVIEWER_PROVIDER=anthropic
# LLM_REVIEWER_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# LLM provider keys (set the ones you'll actually use)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=

# Embedding model — locks the pgvector dimension in the schema (1536).
# Required for brand-voice RAG. OpenAI key needed for first boot even if the
# LLM default is Ollama. See README "Required keys" section.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Embedding dimension is part of the database schema. Do not change without
# a coordinated migration + full re-embed.
EMBEDDING_DIMENSION=1536
#
# Local-dev alternative: run embeddings on Ollama. The 768-dim output of
# nomic-embed-text is zero-padded to fit the vector(1536) column — cosine
# similarity is preserved by the padding (HNSW index keeps working).
# Requires `ollama pull nomic-embed-text` on the host.
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=nomic-embed-text
# Caveat: do not mix providers' samples in one DB — different latent spaces
# don't compare meaningfully even at the same dimension.

# -----------------------------------------------------------------------------
# Tavily — news-awareness tool (post-MVP-1, optional)
# -----------------------------------------------------------------------------
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# LangSmith tracing (optional)
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smn

# -----------------------------------------------------------------------------
# Stripe (Pro tier — $29/mo)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me

# -----------------------------------------------------------------------------
# Meta / Instagram Graph API
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback

# Mock OAuth: when =1, the start route bounces straight to the callback
# with a synthetic code and the token-exchange / profile fetch helpers
# return deterministic stub responses. Lets the full UI flow run without
# Meta App credentials. Off in production.
INSTAGRAM_OAUTH_MOCK=1
# One of BUSINESS | MEDIA_CREATOR | PERSONAL — controls which branch the
# callback takes. PERSONAL exercises the conversion-required refusal path.
INSTAGRAM_OAUTH_MOCK_ACCOUNT_TYPE=BUSINESS
INSTAGRAM_OAUTH_MOCK_USERNAME=mock_handle
INSTAGRAM_OAUTH_MOCK_USER_ID=17841400000000000

# Encryption secret for stored OAuth tokens at rest (min 32 chars).
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=changeme-token-encryption-key-min-32-chars-here

# -----------------------------------------------------------------------------
# Email / SMTP (optional in MVP-1; required for password reset, welcome emails)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME="SMN"

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development
